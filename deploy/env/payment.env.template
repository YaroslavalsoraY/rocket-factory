# ----------------------------
# Настройки gRPC-сервера
# ----------------------------

# Адрес, на котором будет слушать gRPC-сервер
GRPC_HOST=${PAYMENT_GRPC_HOST}

# Порт, на котором будет работать gRPC-сервер
GRPC_PORT=${PAYMENT_GRPC_PORT}

# ----------------------------
# Настройки логгера
# ----------------------------

# Уровень логирования (debug, info, warn, error)
LOGGER_LEVEL=${PAYMENT_LOGGER_LEVEL}

# Выводить логи в формате JSON (true/false)
LOGGER_AS_JSON=${PAYMENT_LOGGER_AS_JSON}
LOGGER_OTLP_ENABLED=${CORE_OTEL_LOGS_ENABLED}
LOGGER_OTLP_ENDPOINT=${CORE_OTEL_LOGS_ENDPOINT}
LOGGER_SERVICE_NAME=payment
LOGGER_ENVIRONMENT=${CORE_OTEL_DEPLOYMENT_ENVIRONMENT}

# ----------------------------
# Настройки трейсинга (OpenTelemetry)
# ----------------------------

# Эндпоинт OpenTelemetry Collector для отправки трейсов
OTEL_EXPORTER_OTLP_ENDPOINT=${PAYMENT_OTEL_EXPORTER_OTLP_ENDPOINT}

# Имя сервиса для трейсинга
OTEL_SERVICE_NAME=${PAYMENT_OTEL_SERVICE_NAME}

# Окружение (development, staging, production)
OTEL_ENVIRONMENT=${PAYMENT_OTEL_ENVIRONMENT}

# Версия сервиса
OTEL_SERVICE_VERSION=${PAYMENT_OTEL_SERVICE_VERSION}