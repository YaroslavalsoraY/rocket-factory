# ----------------------------
# Настройки Kafka
# ----------------------------

# Внешний порт Kafka, через который клиенты подключаются снаружи контейнера
KAFKA_EXTERNAL_PORT=${CORE_KAFKA_EXTERNAL_PORT}

# Внутренний порт Kafka, который используется внутри docker-сети
KAFKA_INTERNAL_PORT=${CORE_KAFKA_INTERNAL_PORT}

# Порт контроллера Kafka (используется при работе в режиме KRaft)
KAFKA_CONTROLLER_PORT=${CORE_KAFKA_CONTROLLER_PORT}

# Порт для веб-интерфейса Kafka UI (например, Kafdrop, Redpanda Console)
KAFKA_UI_PORT=${CORE_KAFKA_UI_PORT}

# OpenTelemetry Collector
OTEL_GRPC_PORT=${CORE_OTEL_GRPC_PORT}
OTEL_HTTP_PORT=${CORE_OTEL_HTTP_PORT}
OTEL_BATCH_SIZE=${CORE_OTEL_BATCH_SIZE}
OTEL_BATCH_TIMEOUT=${CORE_OTEL_BATCH_TIMEOUT}
OTEL_LOG_LEVEL=${CORE_OTEL_LOG_LEVEL}
OTEL_COLLECTOR_HOST=${CORE_OTEL_COLLECTOR_HOST}
OTEL_COLLECTOR_METRICS_PORT=${CORE_OTEL_COLLECTOR_METRICS_PORT}
OTEL_HEALTH_CHECK_PORT=${CORE_OTEL_HEALTH_CHECK_PORT}
OTEL_PPROF_PORT=${CORE_OTEL_PPROF_PORT}
OTEL_ZPAGES_PORT=${CORE_OTEL_ZPAGES_PORT}

# Prometheus
PROMETHEUS_PORT=${CORE_PROMETHEUS_PORT}
PROMETHEUS_SCRAPE_INTERVAL=${CORE_PROMETHEUS_SCRAPE_INTERVAL}
PROMETHEUS_EVALUATION_INTERVAL=${CORE_PROMETHEUS_EVALUATION_INTERVAL}
PROMETHEUS_ORDER_TARGET=host.docker.internal:${ORDER_HTTP_PORT}
PROMETHEUS_ASSEMBLY_TARGET=host.docker.internal:${ASSEMBLY_METRICS_PORT}
ALERTMANAGER_PORT=${CORE_ALERTMANAGER_PORT}
ALERTMANAGER_TELEGRAM_CHAT_ID=${CORE_ALERTMANAGER_TELEGRAM_CHAT_ID}
ALERTMANAGER_TELEGRAM_BOT_TOKEN=${CORE_ALERTMANAGER_TELEGRAM_BOT_TOKEN}

# Grafana
GRAFANA_PORT=${CORE_GRAFANA_PORT}
GRAFANA_ADMIN_USER=${CORE_GRAFANA_ADMIN_USER}
GRAFANA_ADMIN_PASSWORD=${CORE_GRAFANA_ADMIN_PASSWORD}

# Jaeger
JAEGER_HOST=${CORE_JAEGER_HOST}
JAEGER_PORT=${CORE_JAEGER_PORT}
JAEGER_UI_PORT=${CORE_JAEGER_UI_PORT}

# Elasticsearch и Kibana
ELASTICSEARCH_HOST=${CORE_ELASTICSEARCH_HOST}
ELASTICSEARCH_PORT=${CORE_ELASTICSEARCH_PORT}
ELASTICSEARCH_HEAP_SIZE=${CORE_ELASTICSEARCH_HEAP_SIZE}
ELASTICSEARCH_LOGS_INDEX=${CORE_ELASTICSEARCH_LOGS_INDEX}
KIBANA_HOST=${CORE_KIBANA_HOST}
KIBANA_PORT=${CORE_KIBANA_PORT}
